# =============================================================================
# SmartFlow-Quickbooks — Plantilla de variables de entorno
# -----------------------------------------------------------------------------
# Copia este archivo a .env y rellena los valores. NUNCA pongas credenciales
# reales aqui: este archivo SI se versiona. Los archivos .env y .env.prod estan
# en .gitignore y no se entregan.
#
# Referencias:
#   - Detalle tecnico de cada variable: ./CLAUDE.md
#   - Pendientes, riesgos y dependencias: ./docs/ESTADO-DEL-PROYECTO.md
# =============================================================================


# === Requeridas siempre ===
# El arranque (src/config/index.js) hace fail-fast: si falta alguna de estas,
# el proceso no inicia.

# Cadena de conexion a MongoDB. OBLIGATORIA en todos los ambientes.
# DEBE apuntar a un REPLICA SET: el worker usa Change Streams, que NO funcionan
# contra un mongod standalone. El docker-compose levanta el replica set 'rs0'.
MONGODB_URI=mongodb://localhost:27017/smartflow?replicaSet=rs0

# Token de acceso de la app privada de HubSpot. OBLIGATORIO.
HUBSPOT_ACCESS_TOKEN=

# Client ID de la app de QuickBooks (Intuit Developer). OBLIGATORIO.
QB_CLIENT_ID=

# Client Secret de la app de QuickBooks (Intuit Developer). OBLIGATORIO.
QB_CLIENT_SECRET=

# Llave AES-256-GCM para cifrar tokens QB en reposo. OBLIGATORIA.
# Debe tener EXACTAMENTE 64 caracteres hexadecimales (32 bytes) o el arranque
# falla. Genera una con: openssl rand -hex 32
ENCRYPTION_KEY=

# API key interna para los endpoints /auth/quickbooks/{connect,status,disconnect}.
# OBLIGATORIA. Se valida con comparacion timing-safe.
INTERNAL_API_KEY=


# === Requeridas solo en produccion ===
# Necesarias cuando NODE_ENV=production. En development/test el middleware de
# firma de webhooks hace bypass y estas pueden quedar vacias.

# Secreto de la app de HubSpot para validar la firma HMAC de los webhooks
# entrantes (x-hubspot-signature-v3 / v1). Obligatorio en produccion.
HUBSPOT_APP_SECRET=

# Verifier token de Intuit para validar la firma de los webhooks de QuickBooks.
# Obligatorio en produccion.
QB_WEBHOOK_VERIFIER_TOKEN=


# === Conexion / OAuth QuickBooks ===

# Base URL de la API de QuickBooks. Dos valores posibles:
#   - Sandbox:    https://sandbox-quickbooks.api.intuit.com
#   - Produccion: https://quickbooks.api.intuit.com
# El nombre dice "SANDBOX" por legado, pero se usa para ambos ambientes.
QB_SANDBOX_BASE_URL=https://sandbox-quickbooks.api.intuit.com

# Redirect URI registrado en la app de Intuit para el callback OAuth.
# Debe coincidir EXACTO con el configurado en Intuit Developer.
# Ej: https://tu-dominio.com/auth/quickbooks/callback
QB_REDIRECT_URI=


# === Seeding inicial (luego viven por-tenant en Mongo) ===
# Se leen del env solo para el bootstrap. Tras completar el OAuth, las
# credenciales QB reales viven cifradas por-tenant en MongoDB. Opcionales:
# normalmente los tokens se obtienen via el flujo OAuth.

# Token de acceso QB inicial. Opcional; lo habitual es obtenerlo via OAuth.
QB_TEST_ACCESS_TOKEN=

# Realm ID (Company ID) de QuickBooks inicial. Opcional.
QB_REALM_ID=


# === Opcionales (con valor por defecto) ===
# Si se omiten, se aplica el default indicado entre parentesis.

# Puerto HTTP del servidor (default: 3001). El host siempre es 0.0.0.0.
PORT=3001

# Ambiente de ejecucion: development | production | test (default: development).
# En production se activa la validacion de firma de webhooks.
NODE_ENV=development

# Nivel de log de Winston: error | warn | info | debug (default: info).
LOG_LEVEL=info

# Numero maximo de reintentos por job antes de pasar a DEAD_LETTER (default: 3).
MAX_RETRY_ATTEMPTS=3

# Cantidad de jobs procesados en paralelo por el worker (default: 3).
WORKER_CONCURRENCY=3

# Origenes permitidos para CORS, separados por comas.
# Ej: http://localhost:3001,https://app.hubspot.com
# NOTA: hoy esta variable se PARSEA pero NO esta cableada. src/app.js registra
# cors({ origin: true }) (refleja cualquier origen). Cablearla es una mejora
# pendiente (ver docs/ESTADO-DEL-PROYECTO.md).
ALLOWED_ORIGINS=http://localhost:3001,https://app.hubspot.com

# ID del tenant por defecto. El sistema es multi-tenant pero hoy corre con uno.
# IMPORTANTE: si se deja vacia, el codigo usa el fallback hardcodeado
# 'cliente-oficial-1' (src/config/constants.js). Setearla SIEMPRE al tenant real
# que se sembro con seed-tenants.js, o los webhooks crearan jobs para un tenant
# inexistente. Ver riesgos en docs/ESTADO-DEL-PROYECTO.md.
DEFAULT_TENANT_ID=
